  "author": "SC",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "jest --testPathPattern=tests/",
    "test-coverage": "jest --collect-coverage",
    "build": "rimraf lib && tsc",
    "start": "ts-node --experimental-specifier-resolution=node ./src/app.ts",
    "prod": "ts-node --experimental-specifier-resolution=node ./src/app.ts",
    "reg": "npm set registry http://npm.lumigame.com",
    "dev": "ts-node --experimental-specifier-resolution=node ./src/app.ts"
  },
  "jestSonar": {
    "reportPath": "reports",
    "reportFile": "test-reporter.xml",
    "indent": 4
  },
  "dependencies": {
    "@fastify/cors": "^8.3.0",
    "awilix": "^8.0.1",
    "axios": "^1.4.0",
    "fastify": "^4.19.2",
    "mongoose": "7.4.2",
    "openid-client": "^5.4.3",
    "sc-common": "^1.8.1"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.16.11",
    "@types/jest": "^29.5.3",
    "@types/node": "^20.4.5",
    "babel-jest": "^26.6.3",
    "babel-plugin-rewire": "^1.2.0",
    "jest": "^29.6.1",
    "jest-auto-fixture": "^1.0.6",
    "jest-junit": "^13.0.0",
    "jest-sonar-reporter": "^2.0.0",
    "nodemon": "^2.0.15",
    "rimraf": "^5.0.1",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.6"
  }
